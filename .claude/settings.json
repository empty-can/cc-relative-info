{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(cd:*)",
      "Bash(pwd)",
      "Bash(wc:*)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:github.com/anthropics)",
      "Bash(git clone:*)",
      "Bash(git -C:*)",
      "Bash(python LLMs:*)",
      "Bash(python3 LLMs:*)",
      "Bash(bash LLMs:*)",
      "Bash(mkdir -p:*)",
      "Bash(git rev-parse:*)",
      "Bash(echo:*)",
      "Agent(doc-summary-reviewer)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/**)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-task-reminder.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true
  }
}

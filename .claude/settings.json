{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "Bash(git clone *)",
      "Bash(mkdir -p *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git -C * push*)",
      "Bash(git -c * push*)",
      "PowerShell(git push *)",
      "PowerShell(git -C * push*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/**)",
      "Read(~/.claude/.credentials.json)",
      "Bash(git reset *--hard*)",
      "Bash(git -* reset *--hard*)",
      "PowerShell(git reset *--hard*)",
      "PowerShell(git -* reset *--hard*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-task-reminder.sh"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-X",
              "utf8",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/subagent-start-rules.py"
            ]
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true
  }
}

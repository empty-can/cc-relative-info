    "cross-review-reviser": ["{{作業フォルダ}}/30_tmp/**", "{{作業フォルダ}}/11_interim-artifacts/**", "{{報告書の置き場所}}/**", "{{対象の文書のフォルダ}}/**", "C:/tmp/**"],
    "cross-review-diff-checker": ["{{作業フォルダ}}/30_tmp/**", "{{作業フォルダ}}/11_interim-artifacts/**", "C:/tmp/**"],
